{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [ "http://localhost:4200" ],
  "Auth": {
    "Authority": "${OIDC_AUTHORITY}",
    "Audience": "${OIDC_AUDIENCE}"
  },
  "ReverseProxy": {
    "Routes": [],
    "Clusters": []
  },
  "Kestrel": {
    "EndpointDefaults": { "Protocols": "Http1AndHttp2AndHttp3" },
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080" 
      }
    }
  }
}
