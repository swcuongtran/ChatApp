{
  "ReverseProxy": {
    "Routes": {
      "api-chat": {
        "Match": {
          "Path": "/api/chat/{**catch-all}"
        },
        "ClusterId": "chat",
        "Transforms": [
          { "RequestHeaderOriginalHost": "true" },
          { "PathPattern": "/api/{**catch-all}" },
          {
            "RequestHeader": "X-Correlation-Id",
            "Set": "{X-Correlation-Id}"
          },
          {
            "RequestHeader": "X-Forwarded-Proto",
            "Append": "https"
          }
        ]
      },
      "api-stats": {
        "ClusterId": "stats",
        "Match": {
          "Path": "/api/stats/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeaderOriginalHost": "true" },
          {
            "RequestHeader": "X-Correlation-Id",
            "Set": "{X-Correlation-Id}"
          }
        ]
      },
      "api-history": {
        "Match": {
          "Path": "/api/history/{**catch-all}"
        },
        "ClusterId": "history",
        "Transforms": [
          { "RequestHeaderOriginalHost": "true" },
          {
            "RequestHeader": "X-Correlation-Id",
            "Set": "{X-Correlation-Id}"
          },
          {
            "RequestHeader": "X-Forwarded-Proto",
            "Append": "https"
          }
        ]
      },
      "api-presence": {
        "Match": {
          "Path": "/api/presence/{**catch-all}"
        },
        "ClusterId": "presence",
        "Transforms": [
          { "RequestHeaderOriginalHost": "true" },
          {
            "RequestHeader": "X-Correlation-Id",
            "Set": "{X-Correlation-Id}"
          }
        ]
      },
      "api-files": {
        "ClusterId": "file",
        "Match": {
          "Path": "/api/files/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeaderOriginalHost": "true" },
          {
            "RequestHeader": "X-Correlation-Id",
            "Set": "{X-Correlation-Id}"
          }
        ]
      },
      "ws-chat": {
        "Match": {
          "Path": "/ws/chat/{**catch-all}"
        },
        "ClusterId": "delivery",
        "Transforms": [
          { "RequestHeaderOriginalHost": "true" },
          { "RequestHeadersCopy": "true" }
        ]
      },
      "ws-call": {
        "Match": { "Path": "/ws/call" },
        "ClusterId": "signaling",
        "Transforms": [
          { "RequestHeaderOriginalHost": "true" },
          { "RequestHeadersCopy": "true" }
        ]
      },
      "api-search": {
        "ClusterId": "search",
        "Match": {
          "Path": "/api/search/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeaderOriginalHost": "true" },
          {
            "RequestHeader": "X-Correlation-Id",
            "Set": "{X-Correlation-Id}"
          }
        ]
      }
    },
    "Clusters": {
      "chat": {
        "Destinations": {
          "d1": { "Address": "http://chatservice.api:8080" }
        }
      },
      "history": {
        "Destinations": {
          "d1": { "Address": "http://historyservice.api:8080" }
        }
      },
      "presence": {
        "Destinations": {
          "d1": { "Address": "http://presenceservice.api:8080" }
        }
      },
      "delivery": {
        "Destinations": {
          "d1": { "Address": "http://deliveryservice.api:8080" }
        }
      },
      "signaling": {
        "Destinations": {
          "d1": { "Address": "http://signalingservice.api:8080" }
        }
      },
      "search": {
        "Destinations": {
          "d1": { "Address": "http://searchservice.api:8080" }
        }
      },
      "file": {
        "Destinations": {
          "d1": { "Address": "http://fileservice.api:8080" }
        }
      },
      "stats": {
        "Destinations": {
          "d1": { "Address": "http://analyticsservice.api:8080" }
        }
      }
    }
  }
}